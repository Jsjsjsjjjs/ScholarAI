rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Entity Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'nickname', 'email', 'joinedAt', 'colorMode']) &&
             data.keys().size() == 5 &&
             data.uid == request.auth.uid &&
             data.nickname is string && data.nickname.size() >= 2 && data.nickname.size() <= 32 &&
             data.email is string &&
             data.joinedAt is timestamp &&
             data.colorMode in ['light', 'dark'];
    }

    // UserStats Entity Validation
    function isValidUserStats(data) {
      return data.keys().hasAll(['userId', 'nickname', 'quizCorrect', 'accuracy', 'timeSpent', 'lastUpdated']) &&
             data.keys().size() == 6 &&
             data.userId == request.auth.uid &&
             data.nickname is string &&
             data.quizCorrect is int &&
             data.accuracy is number &&
             data.timeSpent is int &&
             data.lastUpdated is timestamp;
    }

    // Paths
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().joinedAt == request.time;
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Action: Change nickname or color mode
        incoming().diff(existing()).affectedKeys().hasOnly(['nickname', 'colorMode'])
      );
    }

    match /stats/{userId} {
      // Leaderboard requires list and get for all users
      allow list, get: if isSignedIn();
      allow create: if isOwner(userId) && isValidUserStats(incoming()) && incoming().lastUpdated == request.time;
      allow update: if isOwner(userId) && isValidUserStats(incoming()) && (
        // Action: Update stats after activity
        incoming().diff(existing()).affectedKeys().hasOnly(['quizCorrect', 'accuracy', 'timeSpent', 'lastUpdated', 'nickname']) &&
        incoming().lastUpdated == request.time
      );
    }
  }
}
