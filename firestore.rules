rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default block: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users and subcollections (doubts, progress, reminders, assets, etc.)
    match /users/{userId} {
      allow read, write: if true;

      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Discord link mappings
    match /discord_links/{linkId} {
      allow read, write: if true;
    }

    // Stats collection (user stats and leaderboard logs)
    match /stats/{userId} {
      allow read, write: if true;
    }

    // Config parameters & application state parameters
    match /system/{docId} {
      allow read, write: if true;
    }

    // Log messages & diagnostic errors
    match /system-logs/{docId} {
      allow read, write: if true;
    }
  }
}
