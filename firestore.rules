rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthed() { return request.auth != null; }
    function isVerified() { 
      return isAuthed() && (request.auth.token.email_verified == true || request.auth.token.email == 'arunwarrior98789@gmail.com'); 
    }
    function isOwner(userId) { return isAuthed() && request.auth.uid == userId; }
    function isAdmin() { 
      return isAuthed() && request.auth.token.email == 'arunwarrior98789@gmail.com';
    }
    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }
    function isOwnerVerified(userId) { 
      return isOwnerOrAdmin(userId); 
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Entity Validation
    function isValidUser(data) {
      return (!('uid' in data) || data.uid == request.auth.uid) &&
             (!('nickname' in data) || (data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 128)) &&
             (!('email' in data) || data.email is string) &&
             (!('role' in data) || data.role in ['owner', 'admin', 'scholar']) &&
             (!('joinedAt' in data) || data.joinedAt is timestamp || data.joinedAt is string) &&
             (!('colorMode' in data) || data.colorMode in ['light', 'dark']) &&
             (!('aiRequests' in data) || data.aiRequests is int) &&
             (!('totalTokens' in data) || data.totalTokens is int) &&
             (!('lastAIActivity' in data) || data.lastAIActivity is timestamp || data.lastAIActivity is string) &&
             (!('quotaExhausted' in data) || data.quotaExhausted is bool) &&
             (!('lastQuotaScan' in data) || data.lastQuotaScan is timestamp || data.lastQuotaScan is string) &&
             (!('lastSync' in data) || data.lastSync is timestamp || data.lastSync is string);
    }

    // UserStats Entity Validation
    function isValidUserStats(data) {
      return (data.userId == request.auth.uid || isAdmin()) &&
             (!('nickname' in data) || data.nickname is string) &&
             (!('quizCorrect' in data) || data.quizCorrect is int) &&
             (!('totalAttempted' in data) || data.totalAttempted is int) &&
             (!('accuracy' in data) || data.accuracy is number) &&
             (!('timeSpent' in data) || data.timeSpent is int);
    }

    // DoubtMessage Entity Validation
    function isValidDoubt(data) {
      return data.keys().hasAll(['role', 'content', 'timestamp']) &&
             data.keys().size() == 3 &&
             data.role in ['user', 'ai'] &&
             data.content is string && data.content.size() <= 100000 &&
             data.timestamp is timestamp;
    }

    // TopicProgress Entity Validation
    function isValidProgress(data) {
      return data.keys().hasAll(['subject', 'topic', 'notesRead', 'quizTaken', 'pyqsViewed', 'lastActivity']) &&
             data.keys().size() == 6 &&
             data.subject is string &&
             data.topic is string &&
             data.notesRead is bool &&
             data.quizTaken is bool &&
             data.pyqsViewed is bool &&
             data.lastActivity is timestamp;
    }

    // Reminder Entity Validation
    function isValidReminder(data) {
      return data.keys().hasAll(['topic', 'subject', 'time', 'date', 'status', 'createdAt']) &&
             data.keys().size() == 6 &&
             data.topic is string && data.topic.size() <= 200 &&
             data.subject is string && data.subject.size() <= 100 &&
             data.time is string &&
             data.date is string &&
             data.status in ['pending', 'completed'] &&
             data.createdAt is timestamp;
    }

    // Paths
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isAuthed();
      allow create: if isOwnerVerified(userId) && 
                       isValidUser(incoming()) && 
                       incoming().uid == request.auth.uid &&
                       incoming().nickname is string &&
                       incoming().email is string &&
                       incoming().joinedAt == request.time &&
                       (!('role' in incoming()) || incoming().role == 'scholar' || request.auth.token.email == 'arunwarrior98789@gmail.com');
      allow update: if isOwnerVerified(userId) || isAuthed();

      match /doubts/{doubtId} {
        allow read: if isOwner(userId) || isAdmin() || isAuthed();
        allow create: if isOwnerVerified(userId) || isAuthed();
      }

      match /progress/{topicId} {
        allow read: if isOwner(userId) || isAdmin() || isAuthed();
        allow create: if isOwnerVerified(userId) || isAuthed();
        allow update: if isOwnerVerified(userId) || isAuthed();
      }

      match /reminders/{reminderId} {
        allow read: if isOwner(userId) || isAdmin() || isAuthed();
        allow create: if isOwnerVerified(userId) || isAuthed();
        allow update: if isOwnerVerified(userId) || isAuthed();
        allow delete: if isOwner(userId) || isAdmin() || isAuthed();
      }
    }

    match /stats/{userId} {
      // Leaderboard requires list and get for all users
      allow read: if isAuthed();
      allow create: if isOwnerVerified(userId) || isAuthed();
      allow update: if isOwnerVerified(userId) || isAuthed();
      allow delete: if isAdmin();
    }
  }
}
