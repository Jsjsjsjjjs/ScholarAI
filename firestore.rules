rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthed() { return request.auth != null; }
    function isVerified() { 
      return isAuthed() && request.auth.token.email_verified == true; 
    }
    function isOwner(userId) { return isAuthed() && request.auth.uid == userId; }
    function isAdmin() { 
      return isAuthed() && (
        request.auth.token.email == 'arunwarrior98789@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner')
      );
    }
    function isOwnerVerified(userId) { 
      return (isOwner(userId) || isAdmin()) && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous'); 
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Entity Validation
    function isValidUser(data) {
      let requiredFields = ['uid', 'nickname', 'email', 'joinedAt', 'colorMode'];
      let optionalFields = [
        'role',
        'discordName', 'discordUsername', 'discordAvatar', 
        'aiRequests', 'totalTokens', 'lastAIActivity', 
        'quotaExhausted', 'lastQuotaScan', 'lastSync'
      ];
      return data.keys().hasAll(requiredFields) &&
             data.keys().size() <= (requiredFields.size() + optionalFields.size()) &&
             data.uid == request.auth.uid &&
             data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 64 &&
             data.email is string &&
             data.joinedAt is timestamp &&
             data.colorMode in ['light', 'dark'] &&
             (!('role' in data) || data.role in ['owner', 'admin', 'scholar']) &&
             (!('aiRequests' in data) || data.aiRequests is int) &&
             (!('totalTokens' in data) || data.totalTokens is int) &&
             (!('lastAIActivity' in data) || data.lastAIActivity is timestamp) &&
             (!('quotaExhausted' in data) || data.quotaExhausted is bool) &&
             (!('lastQuotaScan' in data) || data.lastQuotaScan is timestamp) &&
             (!('lastSync' in data) || data.lastSync is timestamp);
    }

    // UserStats Entity Validation
    function isValidUserStats(data) {
      let requiredFields = ['userId', 'nickname', 'quizCorrect', 'totalAttempted', 'accuracy', 'timeSpent', 'lastUpdated'];
      let optionalFields = ['lastActivity'];
      return data.keys().hasAll(requiredFields) &&
             data.keys().size() <= (requiredFields.size() + optionalFields.size()) &&
             (data.userId == request.auth.uid || isAdmin()) &&
             data.nickname is string &&
             data.quizCorrect is int &&
             data.totalAttempted is int &&
             data.accuracy is number &&
             data.timeSpent is int &&
             data.lastUpdated is timestamp;
    }

    // DoubtMessage Entity Validation
    function isValidDoubt(data) {
      return data.keys().hasAll(['role', 'content', 'timestamp']) &&
             data.keys().size() == 3 &&
             data.role in ['user', 'ai'] &&
             data.content is string && data.content.size() <= 100000 &&
             data.timestamp is timestamp;
    }

    // TopicProgress Entity Validation
    function isValidProgress(data) {
      return data.keys().hasAll(['subject', 'topic', 'notesRead', 'quizTaken', 'pyqsViewed', 'lastActivity']) &&
             data.keys().size() == 6 &&
             data.subject is string &&
             data.topic is string &&
             data.notesRead is bool &&
             data.quizTaken is bool &&
             data.pyqsViewed is bool &&
             data.lastActivity is timestamp;
    }

    // Reminder Entity Validation
    function isValidReminder(data) {
      return data.keys().hasAll(['topic', 'subject', 'time', 'date', 'status', 'createdAt']) &&
             data.keys().size() == 6 &&
             data.topic is string && data.topic.size() <= 200 &&
             data.subject is string && data.subject.size() <= 100 &&
             data.time is string &&
             data.date is string &&
             data.status in ['pending', 'completed'] &&
             data.createdAt is timestamp;
    }

    // Paths
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwnerVerified(userId) && isValidUser(incoming()) && incoming().joinedAt == request.time;
      allow update: if isOwnerVerified(userId) && isValidUser(incoming()) && (
        // Action: Change profile or AI metadata
        incoming().diff(existing()).affectedKeys().hasAny([
          'nickname', 'colorMode', 'discordName', 'discordUsername', 'discordAvatar',
          'aiRequests', 'totalTokens', 'lastAIActivity', 'quotaExhausted', 'lastQuotaScan', 'lastSync',
          'role'
        ])
      );

      match /doubts/{doubtId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwnerVerified(userId) && isValidDoubt(incoming()) && incoming().timestamp == request.time;
      }

      match /progress/{topicId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwnerVerified(userId) && isValidId(topicId) && isValidProgress(incoming()) && incoming().lastActivity == request.time;
        allow update: if isOwnerVerified(userId) && isValidId(topicId) && isValidProgress(incoming()) && (
          // Allow updating progress fields
          incoming().diff(existing()).affectedKeys().hasAny(['notesRead', 'quizTaken', 'pyqsViewed', 'lastActivity']) &&
          incoming().lastActivity == request.time
        );
      }

      match /reminders/{reminderId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwnerVerified(userId) && isValidId(reminderId) && isValidReminder(incoming()) && incoming().createdAt == request.time;
        allow update: if isOwnerVerified(userId) && isValidId(reminderId) && isValidReminder(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        );
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /stats/{userId} {
      // Leaderboard requires list and get for all users
      allow read: if isAuthed();
      allow create: if isOwnerVerified(userId) && isValidUserStats(incoming()) && incoming().lastUpdated == request.time;
      allow update: if isOwnerVerified(userId) && isValidUserStats(incoming()) && (
        // Action: Update stats after activity
        incoming().diff(existing()).affectedKeys().hasOnly(['quizCorrect', 'totalAttempted', 'accuracy', 'timeSpent', 'lastUpdated', 'nickname', 'lastActivity']) &&
        incoming().lastUpdated == request.time
      );
    }
  }
}
